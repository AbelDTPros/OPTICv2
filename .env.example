NODE_ENV=development
PORT=3000
# If 3000 is already taken (Open WebUI and other Docker apps often use it), set PORT to a
# free port such as 3001. Restart both `npm run dev` and `npm run dev:web` so Vite proxies
# /api to the same port.
DATABASE_HOST=127.0.0.1
# Docker Compose publishes MySQL 9.7.2 on 3307. Leave host MySQL on 3306 unused.
DATABASE_PORT=3307
DATABASE_NAME=optic_nextgen
DATABASE_USER=optic
DATABASE_PASSWORD=optic
# Used by repository tests when MySQL is available. Root is required to create ephemeral schemas.
# TEST_DATABASE_URL=mysql://root:optic_root@127.0.0.1:3307/mysql
# Optional admin used by migrate to make audit_event append-only for DATABASE_USER.
# MySQL 9 cannot table-revoke a db.* grant, so migrate strips schema UPDATE/DELETE
# then re-grants them on every table except audit_event.
DATABASE_ADMIN_USER=root
DATABASE_ADMIN_PASSWORD=optic_root
# Local published-package export. GitHub write is not enabled in this slice.
DEFINITION_EXPORT_DIR=./var/definition-export
AUTH_MODE=dev
SERVICE_NAME=api-server
SERVICE_VERSION=0.1.0
LOG_LEVEL=debug
# Production default is false. Stack traces never appear in API responses.
LOG_STACK_TRACES=false
# Product Admin UI/API (feature flags). Defaults: on outside production, off in production.
# FEATURE_ADMIN_UI hides/shows the Admin nav. FEATURE_ADMIN_API gates mutate/list admin APIs.
FEATURE_ADMIN_UI=true
FEATURE_ADMIN_API=true
# Scheduler worker (Slice 11). Disable with SCHEDULER_ENABLED=false.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_BATCH_SIZE=10
SCHEDULER_LEASE_MS=30000
SCHEDULER_BACKOFF_BASE_MS=5000
SCHEDULER_MAX_ATTEMPTS=5
# Outbox publisher (Slice 12). Disable with OUTBOX_PUBLISHER_ENABLED=false.
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=30000
OUTBOX_BACKOFF_BASE_MS=5000
OUTBOX_MAX_ATTEMPTS=5
